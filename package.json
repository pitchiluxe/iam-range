{
  "name": "iam-vm-workstation",
  "type": "module",
  "version": "0.1.0",
  "description": "Standalone IAM operator workstation — the virtual machine from the IAM & SSO 3D Lab, running on its own.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "build:icons": "node build-icons.cjs",
    "electron:dev": "electron electron/main.cjs",
    "build:desktop": "npm run build && npm run build:icons && electron-builder --publish never",
    "release": "npm run build && npm run build:icons && electron-builder --publish always"
  },
  "dependencies": {
    "nanoid": "^5.0.0",
    "zustand": "^4.5.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mydigitalsolutions.iamworkstation",
    "productName": "Identity Operations Workstation",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pitchiluxe",
        "repo": "iam-workstation",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "IAM-Workstation-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Identity Operations Workstation"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "IAM-Workstation-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "artifactName": "IAM-Workstation-${version}.${ext}"
    }
  },
  "author": {
    "name": "Erick Omari"
  },
  "license": "MIT"
}
